# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =========================
# Dependencies
# =========================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# =========================
# Environment & secrets (never upload)
# =========================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
secrets.json
service-account*.json
*.credentials
.clerk/

# =========================
# Next.js / build output
# =========================
/.next/
/out/
/build
/dist
/.swc/
*.tsbuildinfo
next-env.d.ts

# =========================
# Caches & temp files
# =========================
.turbo
.cache
.parcel-cache
.eslintcache
*.tmp
*.temp
tmp/
temp/

# =========================
# Logs & debug
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# =========================
# Testing
# =========================
/coverage
.nyc_output

# =========================
# Database (local dev only)
# =========================
*.db
*.db-journal
*.sqlite
*.sqlite3
/prisma/dev.db
/prisma/*.db

# =========================
# Hosting / deployment
# =========================
.vercel
.netlify

# =========================
# OS files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# =========================
# Editor / IDE
# =========================
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

# =========================
# Misc
# =========================
*.local
