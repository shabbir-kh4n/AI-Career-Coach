# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# ==========================================
# DATABASE
# ==========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/ai_career_coach

# ==========================================
# AI / GEMINI
# ==========================================
# Google Generative AI API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sk_your_api_key_here

# ==========================================
# CLERK AUTHENTICATION
# ==========================================
# Clerk Publishable Key
# Get from: https://clerk.com/docs/quickstarts/setup-clerk
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Clerk Secret Key (Never commit this!)
CLERK_SECRET_KEY=sk_test_your_secret_here

# ==========================================
# APPLICATION
# ==========================================
# Node environment
NODE_ENV=development

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# ==========================================
# OPTIONAL - INNGEST (Background Jobs)
# ==========================================
# INNGEST_EVENT_KEY=your_inngest_event_key
# INNGEST_SIGNING_KEY=your_inngest_signing_key
